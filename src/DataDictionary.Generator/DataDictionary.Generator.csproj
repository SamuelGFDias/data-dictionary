<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!--
      This project emits an IIncrementalGenerator (DataDictionaryIncrementalGenerator)
      and DiagnosticDescriptor-based diagnostics (DD0001-DD0007), so the SDK's
      generator-project meta-analyzers (Microsoft.CodeAnalysis.Analyzers) activate
      automatically. EnforceExtendedAnalyzerRules opts into the additional
      correctness rules for incremental generators specifically (RS1036) rather than
      only the base analyzer rules.
    -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!--
      Standard packaging shape for a Roslyn analyzer/source generator NuGet package:
      the generator DLL ships under analyzers/dotnet/cs (not lib/), and the package
      is marked as a development-time-only dependency.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageType>DevelopmentDependency</PackageType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Roslyn incremental source generator for DataDictionary — reads marked enums and emits, at compile time, the manifest, EF Core mapping, and enum-to-code value converters.</Description>
    <PackageTags>datadictionary;source-generator;roslyn;analyzer</PackageTags>
    <!--
      NU5128 fires because this is an analyzer-only package (IncludeBuildOutput=false,
      DevelopmentDependency=true above): the generator DLL only ever ships under
      analyzers/dotnet/cs, never under lib/ or ref/, for any TFM. NuGet's warning that
      the netstandard2.0 dependency group has no lib/ref match is expected and
      unavoidable for this package shape, not a sign of a real defect — the same
      pattern Microsoft's own Roslyn analyzer templates suppress.
    -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      RS2008 (analyzer release tracking) requires these two files for every project
      that declares DiagnosticDescriptor-based rules (DD0001-DD0007) — see
      AnalyzerReleases.Unshipped.md for the actual rule catalog.
    -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
